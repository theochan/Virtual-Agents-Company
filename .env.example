# ANTHROPIC_API_KEY: Required for Anthropic Claude models (claude-3-5-sonnet, claude-3-7-sonnet, claude-3-5-haiku).
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# OPENAI_API_KEY: Optional, for OpenAI models (gpt-4o, gpt-4o-mini).
OPENAI_API_KEY="your_openai_api_key_here"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3001"

# OMNIROUTE: Local/Remote Multi-Provider AI Gateway
# Endpoint defaults to http://localhost:20128/v1
OMNIROUTE_ENDPOINT="http://localhost:20128/v1"
# API Key / Access Token generated via omniroute dashboard or CLI (omniroute tokens create)
OMNIROUTE_API_KEY="your_omniroute_api_key_here"

