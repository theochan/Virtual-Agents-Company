# Node 24 is required. The service binds to 127.0.0.1 only.
PORT=3001
# VAC_DATA_DIR defaults to ./data. Keep it outside public/shared directories.
# VAC_ACCESS_TOKEN must have at least 32 characters if set.
# If omitted, startup creates data/access-token with owner-only permissions.
# VAC_ACCESS_TOKEN=

# Leave unused credentials empty. LLM keys entered in the UI expire on restart.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
HF_TOKEN=

# Search credentials (optional). UI-saved values override these and persist in
# private search-credentials.json outside database backups. Remove key saves an empty override.
# DuckDuckGo only provides limited encyclopedia summaries.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

OLLAMA_ENDPOINT=http://127.0.0.1:11434
HF_LOCAL_ENDPOINT=http://127.0.0.1:8000/v1

# Extra exact provider bases must be approved by the operator here, not by API callers.
# Comma-separated; credentials may be sent to these addresses. Redirects are forbidden.
# VAC_OPENAI_ENDPOINTS=https://your-trusted-gateway.example/v1
# VAC_HUGGINGFACE_ENDPOINTS=https://your-trusted-inference.example/v1

# Bounded timeouts in milliseconds (invalid values stop startup).
# LLM_TIMEOUT_MS=300000  # permitted: 5000..900000
# RUN_TIMEOUT_MS=600000  # permitted: 30000..1800000

# Durable daily attempt limits, each 0..10000. Failed calls consume reservations.
VAC_INFERENCE_REQUESTS_PER_DAY=100
# Set unlimited for no daily Tavily/Brave cap, or an integer 0..10000.
# Zero disables paid search; provider billing and rate limits still apply.
VAC_SEARCH_REQUESTS_PER_DAY=0
# Configure provider-side spending limits before enabling paid cloud inference.
VAC_ALLOW_PAID_INFERENCE=0
# Scheduled snapshots default to a private local folder in the service config.
# VAC_BACKUP_DIR=/absolute/private/data/backups

# Opt-in direct-subordinate read-only pilot; manager also needs tool-delegate.
VAC_ENABLE_DELEGATION=0
